generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             Int                @id @default(autoincrement())
  email          String             @unique
  name           String
  lastName       String
  password       String
  weight         Float?
  height         Float?
  dateOfBirth    DateTime?
  unitPreference String?            @default("metric")
  weekStartDay   Int?               @default(1)
  avatar             String?
  resetToken         String?
  resetTokenExpiry   DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?
  workouts       Workout[]
  executions     WorkoutExecution[]
  apiTokens      ApiToken[]
  trainingProfile TrainingProfile?
}

// Persisted training constraints — what makes guideline/plan tools work the
// same across every MCP client and session instead of being re-inferred from
// conversation. Multi-valued fields are JSON string arrays validated against
// closed vocabularies (src/lib/trainingVocab.ts, exerciseTaxonomy.ts).
model TrainingProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  experienceLevel Int? // 1–10 self-assessed
  // Deprecated by primaryOutcome — read-only alias for one release so existing
  // MCP clients keep working (r3-amendment §2.1). Writes go to primaryOutcome.
  goal            String?
  // What the user is actually training for (PRIMARY_OUTCOMES). Split out of
  // `goal`, which conflated outcome, modality and adherence state.
  primaryOutcome    String?
  secondaryOutcomes String? // JSON array — same vocabulary as primaryOutcome
  // Equipment inventory. Schema 2 is { schema, items[] } with load data; bare
  // JSON arrays are schema 1 and are upgraded on read (lib/equipmentInventory.ts).
  equipment       String?
  spaceConstraint String? // largest footprint available (exerciseTaxonomy SPACE_FOOTPRINTS)
  daysPerWeek     Int?
  // Target session length. Feeds planned-vs-actual duration and the volume
  // budget solver, both of which need a number the app never stored before.
  minutesPerSession Int?
  injuries        String? // JSON array — closed condition list (trainingVocab.ts)
  // JSON array of { exerciseId, reason, addedAt } — reason from EXCLUSION_REASONS.
  excludedExercises String?
  // Manual override only. The tier is normally derived from execution history
  // (get_training_signals); this column exists because a user who trains
  // without logging is indistinguishable from one who doesn't train, and the
  // tier gates plan validation (r3-amendment §4.13, §9). Null = use derived.
  adherenceTier      String?
  consecutiveWeeksOk Int? // cached derivation, refreshed from history
  typicalSleepHours  Float?
  lifeStressLevel    String? // LIFE_STRESS_LEVELS — caps intensity (§4.5)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
}

model ApiToken {
  id          Int       @id @default(autoincrement())
  userId      Int
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
}

model Exercise {
  id          Int                   @id @default(autoincrement())
  name        String                @unique
  description String?
  image       String?
  videoUrl    String?
  // Taxonomy — String columns validated against closed vocabularies in
  // src/lib/exerciseTaxonomy.ts (Prisma enums are not supported on SQLite).
  // Multi-valued fields are JSON-encoded string arrays.
  equipment        String?
  primaryMuscle    String?
  secondaryMuscles String?
  movementPattern  String?
  spaceFootprint   String?
  difficulty       String?
  // Provenance — filtered reads default to curated-only rows.
  source     String    @default("user")
  license    String?
  isCurated  Boolean   @default(false)
  verifiedAt DateTime?
  aliases    ExerciseAlias[]
  blocks     WorkoutSessionBlock[]

  @@index([isCurated])
  @@index([movementPattern])
  @@index([primaryMuscle])
}

// Many names → one canonical exercise ("DB Press" → "Dumbbell Bench Press").
// Aliases are stored normalized (lowercase, trimmed) — see exerciseTaxonomy.ts.
model ExerciseAlias {
  id         Int      @id @default(autoincrement())
  alias      String   @unique
  exerciseId Int
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

model Workout {
  id           Int                @id @default(autoincrement())
  name         String
  instructions String?
  userId       Int
  user       User               @relation(fields: [userId], references: [id])
  sessions   WorkoutSession[]
  executions WorkoutExecution[]
}

model WorkoutSession {
  id         Int                   @id @default(autoincrement())
  workoutId  Int
  name       String?
  order      Int
  workout    Workout               @relation(fields: [workoutId], references: [id])
  blocks     WorkoutSessionBlock[]
  executions WorkoutExecution[]
}

model WorkoutSessionBlock {
  id             Int                       @id @default(autoincrement())
  sessionId      Int
  exerciseId     Int
  instructions   String?
  notes          String?
  order          Int
  supersetGroupId String?
  mode           String                    @default("reps")
  session      WorkoutSession            @relation(fields: [sessionId], references: [id])
  exercise     Exercise                  @relation(fields: [exerciseId], references: [id])
  items        WorkoutSessionBlockItem[]
}

model WorkoutSessionBlockItem {
  id           Int                            @id @default(autoincrement())
  blockId      Int
  reps         Int?
  weight       Float?
  duration     Int? // seconds
  instructions String?
  order        Int
  block      WorkoutSessionBlock            @relation(fields: [blockId], references: [id])
  executions WorkoutSessionBlockExecution[]
}

model WorkoutExecution {
  id              Int                            @id @default(autoincrement())
  workoutId       Int
  sessionId       Int?
  userId          Int
  date            DateTime
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime                       @default(now())
  workout         Workout                        @relation(fields: [workoutId], references: [id])
  session         WorkoutSession?                @relation(fields: [sessionId], references: [id])
  user            User                           @relation(fields: [userId], references: [id])
  blockExecutions WorkoutSessionBlockExecution[]
}

model WorkoutSessionBlockExecution {
  id                      Int                     @id @default(autoincrement())
  workoutExecutionId      Int
  workoutSessionBlockItemId Int
  reps                    Int?
  weight                  Float?
  duration                Int? // seconds
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  workoutExecution        WorkoutExecution        @relation(fields: [workoutExecutionId], references: [id])
  workoutSessionBlockItem WorkoutSessionBlockItem @relation(fields: [workoutSessionBlockItemId], references: [id])
}
